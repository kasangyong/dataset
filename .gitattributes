# CI writes on Linux, development happens on Windows. Without a forced line
# ending every daily commit would rewrite every file it touches.
* text=auto eol=lf

*.json.gz binary

# Collected data is machine-written; keep it out of diff stats and reviews.
data/** linguist-generated=true

# Append-only: a run here and a run in CI both add lines, and every line is
# wanted. Git's union driver keeps both sides instead of raising a conflict.
data/_manifest.jsonl merge=union
